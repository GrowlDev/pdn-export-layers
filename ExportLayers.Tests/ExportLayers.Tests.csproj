<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <PdnRoot>C:\Program Files\paint.net</PdnRoot>
    <!-- The test-.pdn generator uses Paint.NET's Document.SaveToStream, which needs the
         BinaryFormatter compatibility package (same as Paint.NET itself ships). -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExportLayers\ExportLayers.csproj" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Base.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.ComponentModel.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Core.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Data.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Effects.Core.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Fundamentals.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.ObjectModel.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Primitives.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Windows.dll" Private="false" />
    <Reference Include="$(PdnRoot)\PaintDotNet.Windows.Core.dll" Private="false" />
  </ItemGroup>

</Project>
